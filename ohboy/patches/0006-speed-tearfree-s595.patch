+
+/*
+** s583 (patch 0010): direct screen writes. On the Leapster the screen surface is SDL_SWSURFACE, a
+** RAM copy that SDL_Flip copies to the framebuffer: measured 2.1 ms per frame, on top of 1.1 ms
+** for the scaler (device-upscale-2026-11-22.txt). When a frame is only the plain fullscreen scale
+** (upscaler 4, no blending, no volume bar, no FPS counter, no clear) it is scaled straight into
+** the visible framebuffer and SDL_Flip is skipped. SDL's RAM copy is then stale; vid_shadow_sync()
+** (called by gui_begin before the menu copies the screen as its background) refreshes it.
+** Every other frame takes the old path, which redraws the whole RAM copy and flips it.
+** Used only with SDL's fbcon driver on /dev/fb0 in exactly the screen's format (320x240, 16 bpp
+** RGB565 packed, 640-byte lines, no x offset), and only while the framebuffer is not panned
+** (checked before every direct frame). OHBOY_NODIRECT=1 turns it off. Known, accepted: after a
+** console switch SDL may flash its stale copy for one frame (Codex chunk 9; never seen here).
+*/
+static un16 *vid_direct = 0;
+/* s595 (patch 0021): no tearing. Measured on the Leapster (s595, patch 0020 test): the screen
+** refreshes at 61.23 Hz, OhBoy draws when the sound buffer lets it (Game Boy 59.73 Hz), so writes
+** into the visible picture were caught by the scan in 37-62 % of changed frames (older builds 71-83 %).
+** Now direct frames go to a page of fb0 that is neither on screen nor queued, then FBIOPAN_DISPLAY
+** queues it; the lf1000 display takes a new address only at a refresh, so a refresh always shows one
+** whole frame. Its FBIO_WAITFORVSYNC does not wait: it returns 1 while a pan is still queued. With 3
+** pages a frame never waits (a newer pan replaces a queued one; that frame is simply never shown,
+** as before). If only 2 pages fit, a frame waits (at most 50 ms) until the last pan was taken.
+** SDL's mode set leaves a 240-line virtual screen, so the pages are requested with
+** FBIOPUT_VSCREENINFO. SDL frames (menu, borders, volume bar, FPS) draw page 0: vid_shadow_sync()
+** and the SDL path go back to page 0 first. At exit the newest frame is copied to page 0 and shown.
+** OHBOY_NOPAGEFLIP=1 = off (plain direct writes as in s585). */
+static int pf_n = 0, pf_shown = 0, pf_queued = -1, pf_newest = 0; static un16 *pf_page[3];
+static byte pf_pend[3][144]; static int pf_all[3] = {1, 1, 1};
+static struct fb_var_screeninfo pf_var;
+static void pf_pan(int p);
+static void pf_restore(void)
+{
+	if (pf_n && pf_newest) { memcpy(pf_page[0], pf_page[pf_newest], 240 * 640); pf_pan(0); }
+}
+static int vid_direct_state = 0;   /* 0 = not tried yet, 1 = usable, -1 = off */
+static int vid_shadow_stale = 0;
+static int vid_direct_fd = -1;
+/* s585 (0017): 1 = the direct screen shows exactly the last direct frame (no SDL flip since) */
+static int vid_direct_valid = 0;
+static int vid_nopartial = -1;
+static unsigned vid_direct_yoff;
+static void pf_pan(int p)   /* s595 (0021): queue page p of fb0 for the next refresh */
+{
+	pf_var.xoffset = 0; pf_var.yoffset = p * 240;
+	ioctl(vid_direct_fd, FBIOPAN_DISPLAY, &pf_var);
+	pf_queued = p; pf_newest = p; vid_direct = pf_page[p]; vid_direct_yoff = p * 240;
+}
+static void pf_poll(void)   /* queued pan taken by the display? (FBIO_WAITFORVSYNC = MLC dirty bit) */
+{
+	unsigned a = 0;
+	if (pf_queued >= 0 && ioctl(vid_direct_fd, _IOW('F', 0x20, unsigned int), &a) == 0) { pf_shown = pf_queued; pf_queued = -1; }
+}
+static int pf_pick(void)   /* a page that is neither on screen nor queued */
+{
+	struct timeval t0, t; int p;
+	pf_poll();
+	if (pf_n == 2 && pf_queued >= 0) {
+		gettimeofday(&t0, 0);
+		do {
+			sched_yield(); pf_poll(); gettimeofday(&t, 0);
+			if ((t.tv_sec - t0.tv_sec) * 1000000L + (t.tv_usec - t0.tv_usec) > 50000) { pf_shown = pf_queued; pf_queued = -1; }
+		} while (pf_queued >= 0);
+	}
+	for (p = 0; p < pf_n; p++) if (p != pf_shown && p != pf_queued) return p;
+	return (pf_shown + 1) % pf_n;
+}
+
+static int vid_direct_ok()
+{
+	struct fb_var_screeninfo v;
+	struct fb_fix_screeninfo f;
+	int fd;
+	void *m;
+	char drv[16];
+	const char *dev = getenv("SDL_FBDEV");
+#ifdef OHBOY_FAKEDIRECT
+	/* s585 test builds only (-DOHBOY_FAKEDIRECT): "direct" frames go to a RAM buffer, so the bench
+	** can hash the direct path (incl. 0017's partial scaling) without a Leapster framebuffer */
+	if (pcm_bench && getenv("OHBOY_FAKEDIRECT")) {
+		static un16 fake[320 * 240];
+		vid_direct = fake; vid_direct_state = 1;
+		return 1;
+	}
+#endif
+	if (vid_direct_state > 0)
+	{
+		/* still the same screen position? (SDL or another program could pan the framebuffer) */
+		if (ioctl(vid_direct_fd, FBIOGET_VSCREENINFO, &v) == 0 && v.yoffset == vid_direct_yoff && v.xoffset == 0)
+			return 1;
+		vid_direct_state = -1;
+		fprintf(stderr, "ohboy: framebuffer moved, direct video writes off\n");
+		return 0;
+	}
+	if (vid_direct_state) return 0;
+	vid_direct_state = -1;
+	if (getenv("OHBOY_NODIRECT") && *getenv("OHBOY_NODIRECT") == '1') return 0;
+	/* only SDL's own fbcon driver on /dev/fb0, with the screen as a plain software surface */
+	if (!SDL_VideoDriverName(drv, sizeof drv) || strcmp(drv, "fbcon") || (dev && strcmp(dev, "/dev/fb0"))) return 0;
+	if (!screen || (screen->flags & (SDL_HWSURFACE | SDL_DOUBLEBUF)) || screen->w != 320 || screen->h != 240
+		|| screen->pitch != 640 || screen->format->BitsPerPixel != 16 || screen->format->Rmask != 0xf800
+		|| screen->format->Gmask != 0x07e0 || screen->format->Bmask != 0x001f) return 0;
+	if ((fd = open("/dev/fb0", O_RDWR)) < 0) return 0;
+	if (ioctl(fd, FBIOGET_VSCREENINFO, &v) || ioctl(fd, FBIOGET_FSCREENINFO, &f)
+		|| f.type != FB_TYPE_PACKED_PIXELS || v.xres != 320 || v.yres != 240 || v.xoffset != 0
+		|| v.bits_per_pixel != 16 || f.line_length != 640
+		|| v.red.offset != 11 || v.red.length != 5 || v.red.msb_right
+		|| v.green.offset != 5 || v.green.length != 6 || v.green.msb_right
+		|| v.blue.offset != 0 || v.blue.length != 5 || v.blue.msb_right
+		|| (f.smem_start & 4095) || (v.yoffset + 240) * 640 > f.smem_len) { close(fd); return 0; }
+	/* s595 (0021): three pages if the driver gives them, else two, else none */
+	pf_n = (getenv("OHBOY_NOPAGEFLIP") && *getenv("OHBOY_NOPAGEFLIP") == '1') || v.yoffset ? 0 : 3;
+	while (pf_n >= 2) {
+		if ((unsigned)pf_n * 240 * 640 <= f.smem_len) {
+			struct fb_var_screeninfo v2 = v;
+			if (v.yres_virtual >= (unsigned)pf_n * 240) break;
+			v2.yres_virtual = pf_n * 240; v2.xres_virtual = 320; v2.yoffset = 0;
+			if (!ioctl(fd, FBIOPUT_VSCREENINFO, &v2) && !ioctl(fd, FBIOGET_VSCREENINFO, &v) && !ioctl(fd, FBIOGET_FSCREENINFO, &f)
+				&& v.yres_virtual >= (unsigned)pf_n * 240 && v.xres == 320 && v.yres == 240 && v.bits_per_pixel == 16
+				&& f.line_length == 640 && !v.yoffset && v.xoffset == 0) break;
+			if (v.xres != 320 || v.yres != 240 || v.bits_per_pixel != 16 || f.line_length != 640 || v.yoffset || v.xoffset) {
+				close(fd); return 0;   /* the driver changed something else: no direct writes at all */
+			}
+		}
+		pf_n--;
+	}
+	if (pf_n < 2) pf_n = 0;
+	m = mmap(0, pf_n ? pf_n * 240 * 640 : (v.yoffset + 240) * 640, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+	if (m == MAP_FAILED) { close(fd); return 0; }
+	vid_direct = (un16 *)((byte *)m + v.yoffset * 640);
+	vid_direct_fd = fd;   /* kept open for the per-frame position check */
+	vid_direct_yoff = v.yoffset;
+	if (pf_n) {   /* s595 (0021) */
+		int i;
+		for (i = 0; i < pf_n; i++) pf_page[i] = (un16 *)((byte *)m + i * 240 * 640);
+		pf_var = v; pf_shown = 0; pf_queued = -1; pf_newest = 0;
+		atexit(pf_restore);
+		fprintf(stderr, "ohboy: tear-free page flip, %d pages (OHBOY_NOPAGEFLIP=1 = off)\n", pf_n);
+	}
+	fprintf(stderr, "ohboy: video writes go straight to /dev/fb0 (OHBOY_NODIRECT=1 = off)\n");
+	vid_direct_state = 1;
+	return 1;
+}
+
+/* bring SDL's RAM copy of the screen up to date after direct frames (before the GUI reads it) */
+void vid_shadow_sync()
+{
+	pf_restore();   /* s595 (0021): SDL draws page 0, so show page 0 with the newest frame */
+	if (!vid_shadow_stale) return;
+	SDL_LockSurface(screen);
+	gb_upscale((uint32_t *)screen->pixels, (uint32_t *)vid_frame);
+	SDL_UnlockSurface(screen);
+	vid_shadow_stale = 0;
+}
+
+void vid_end() {
+	if(fb.enabled){
+		int skip, same;
+		if (vid_noskip < 0) vid_noskip = getenv("OHBOY_NOSKIP") && *getenv("OHBOY_NOSKIP") == '1';
+		same = vid_frame_unchanged();   /* also clears lcd_frame_changed for the next frame */
+		skip = same && vid_shown_ok && !vid_noskip && !vid_fb.dirty && !blendframes
+			&& !osd_persist && !dvolume && !sdl_showfps;
+		if (pcm_bench) { static int told; if (!told++) {   /* s583: where the screen surface lives */
+			char l[256]; FILE *m = fopen("/proc/self/maps", "r");
+			fprintf(stderr, "ohboy bench screen pixels %p flags 0x%x pitch %d\n", screen->pixels, screen->flags, screen->pitch);
+			while (m && fgets(l, sizeof l, m)) if (strstr(l, "fb")) fprintf(stderr, "ohboy bench map %s", l);
+			if (m) fclose(m); } }
+		if (pcm_bench) { static int ns, nsame, nf; nf++; ns += skip; nsame += same; if (nf % 600 == 0) { extern int lcd_lines_skipped, lcd_lines_drawn; fprintf(stderr, "ohboy bench skip %d same %d of %d dirty %d ok %d lines skipped %d drawn %d\n", ns, nsame, nf, vid_fb.dirty, vid_shown_ok, lcd_lines_skipped, lcd_lines_drawn); } }
+		int was_shown_ok = vid_shown_ok;   /* s585 (0017) */
+		vid_shown_ok = 1;
+		if (!skip && upscaler == 4 && !blendframes && !osd_persist && !dvolume && !sdl_showfps
+			&& !vid_fb.dirty && vid_direct_ok()) {
+			if (vid_nopartial < 0) vid_nopartial = getenv("OHBOY_NOPARTIAL") && *getenv("OHBOY_NOPARTIAL") == '1';
+			if (pf_n) {   /* s595 (0021): draw a hidden page, then queue it */
+				int full = !(vid_direct_valid && was_shown_ok && !lcd_rows_all && !vid_nopartial);
+				int b, i, p;
+				/* each page remembers the rows changed since it was last drawn */
+				for (p = 0; p < pf_n; p++) {
+					if (full) pf_all[p] = 1;
+					for (i = 0; i < 144; i++) pf_pend[p][i] |= lcd_row_dirty[i];
+				}
+				b = pf_pick();
+				if (pf_all[b]) gb_upscale((uint32_t *)pf_page[b], (uint32_t *)fb.ptr);
+				else { memcpy(lcd_row_dirty, pf_pend[b], 144); gb_upscale_rows((uint32_t *)pf_page[b], (uint32_t *)fb.ptr); }
+				memset(pf_pend[b], 0, 144); pf_all[b] = 0;
+				pf_pan(b);
+			} else if (vid_direct_valid && was_shown_ok && !lcd_rows_all && !vid_nopartial)
+				gb_upscale_rows((uint32_t *)vid_direct, (uint32_t *)fb.ptr);   /* s585 (0017) */
+			else
+				gb_upscale((uint32_t *)vid_direct, (uint32_t *)fb.ptr);   /* s583: no SDL copy, no flip */
+			memset(lcd_row_dirty, 0, sizeof lcd_row_dirty);
+			lcd_rows_all = 0;
+			vid_direct_valid = 1;
+			vid_shadow_stale = 1;
+			skip = 2;
+		}
+		if (!skip) {
+		vid_direct_valid = 0;   /* s585 (0017): this frame goes through SDL's copy and a flip */
+		vid_shadow_stale = 0;   /* the code below redraws all of SDL's RAM copy, then flips it */
+		vid_fb.ptr = screen->pixels;
+		SDL_LockSurface(screen);
+
+		if(vid_fb.dirty){
+			memset(vid_fb.ptr,0,vid_fb.pitch*vid_fb.h);
+			vid_fb.dirty = 0;
+		}
+
+		if(blendframes){
+			ohb_blend_frames();
+		}
+
+		switch (upscaler){
+			case 1:
+				if(blendframes){
+					blend_ayla_scale15x();
+				} else {
+					ohb_ayla_scale15x();
+				}
+				break;
+			case 2:
+				if(blendframes){
+					blend_scale3x();
+				} else {
+					ohb_scale3x();
+				}
+				break;
+			case 3:
+				if(blendframes){
+					blend_scale_aspect();
+				} else {
+					ohb_scale_aspect();
+				}
+				break;
+			case 4:
+				if(blendframes){
+					blend_ayla_dingoo_scale();
+				} else {
+					ohb_ayla_dingoo_scale();
+				}
+				break;
+#ifdef GCWZERO
+			case 5:
+				if(blendframes){
+					blend_hardware_15x_scale();
+				} else {
+					ohb_hardware_15x_scale();
+				}
+				break;
+			case 6:
+				if(blendframes){
+					blend_hardware_1666x_scale();
+				} else {
+					ohb_hardware_1666x_scale();
+				}
+				break;
+			case 7:
+				if(blendframes){
+					blend_hardware_fullscreen_scale();
+				} else {
+					ohb_hardware_fullscreen_scale();
+				}
+				break;
+#endif
+			case 0:
+			default:
+				if(blendframes){
+					blend_no_scale();
+				} else {
+					ohb_no_scale();
+				}
+				break;
+		}
+
+		if(osd_persist || dvolume){
+			osd_volume();
+			vid_fb.dirty=1;
+			vid_shown_ok = 0;   /* s583: the bar is on screen; draw the next frame too */
+			if(osd_persist) osd_persist--;
+		}
+		SDL_UnlockSurface(screen);
+		}   /* s583: !skip */
+        
+        /* 
+        ** NOTE Oh Boy now has the option of 2 font systems...
+        ** 1) the original Oh Boy ttf approach - gui_drawtext()
+        ** 2) SFont (part of SDL gnuboy)
+        ** Oh Boy uses SFont (bitmap approach) from gnuboy for FPS indicator
+        ** Rest of the GUI (menu) can either use TTF or SFont.
+        ** TODO start using SFont in gui_drawtext(), and expose gui_drawtext() to this module.
+        */
+        if (sdl_showfps)
+        {
+            fps_current_time = SDL_GetTicks();
+            fps_current_count++;
+            if (sdl_showfps == 1)
+            {
+                snprintf(fps_str, 19, "%02d", fps_last_count);
+				myrect.w = SFont_TextWidth(fps_font, fps_str);
+                SDL_FillRect(screen, &myrect, 0 );
+            }
+
+            SFont_Write(screen, fps_font, 0,0, fps_str);
+            if ( fps_current_time - fps_last_time >= 1000 )
+            {
+                /* reset fps count every second (not every frame) */
+                fps_last_count = fps_current_count;
+                fps_current_count = 0;
+                fps_last_time = fps_current_time;
+            }
+        }
+
+		if (pcm_bench) {   /* s583: speed test also proves the picture and sound did not change */
+			static int n = 0;
+			if (++n % 60 == 0) {
+				unsigned h = 2166136261u; int y, x;
+				for (y = 0; y < screen->h; y++) {   /* s583: hash what is really on the screen */
+					byte *r = (vid_shadow_stale ? (byte *)vid_direct : (byte *)screen->pixels) + y * screen->pitch;
+					for (x = 0; x < screen->w * 2; x++) h = (h ^ r[x]) * 16777619u;
+				}
+				fprintf(stderr, "ohboy bench frame %d video %08x sound %08x\n", n, h, bench_sound_hash);
+			}
+		}
+		if (!skip) {
+			SDL_Flip(screen);
+			if (pf_n && pf_newest) pf_pan(0);   /* s595 (0021): SDL drew page 0 */
+		}
+	}
+	framecounter++;
+	if(framecounter>frameskip) framecounter = 0;
+
+}
+
+/*
+** s580 sound path rework (Leapster Explorer):
+**  - the ring buffer is guarded by SDL_LockAudio() (the callback runs under the same lock);
+**    before, pcm_buffered += / -= raced between the emulator and the audio thread
+**  - the callback copies what is really queued (any len) and leaves silence for the rest
+**  - the producer waits with SDL_Delay(1) instead of a 100% CPU spin (one ARM9 core is
+**    shared with the audio thread), gives up after 500 ms, and still honours SIGTERM
+**  - SDL audio errors are logged; if audio can't open, pcm_submit() returns 0 so the
+**    emulator falls back to timer pacing (before: no sound AND no speed limit, silently)
+*/
+void sram_flush_now();   /* s580, gnuboy/loader.c */
+void ev_clear();   /* s580, gnuboy/events.c */
+void pad_refresh();
+static int pcm_ok = 0;
+static int pcm_rd = 0, pcm_wr = 0;
+static volatile int pcm_underruns = 0;   /* ring indices in n16 samples, guarded by SDL audio lock */
+extern volatile sig_atomic_t ohb_quit_requested;
+
+static void audio_callback(void *d, byte *stream, int len) {
+	int want = len / (int) sizeof(n16), n, first;
+	n16 *out = (n16 *) stream;
+
+	n = pcm_buffered < want ? pcm_buffered : want;
+	first = pcm_bufferlen - pcm_rd;
+	if (first > n) first = n;
+	memcpy(out, pcm_buffer + pcm_rd, first * sizeof(n16));
+	if (n > first) memcpy(out + first, pcm_buffer, (n - first) * sizeof(n16));
+	pcm_rd = (pcm_rd + n) % pcm_bufferlen;
+	pcm_buffered -= n;
+	if (n < want) {
+		memset(out + n, 0, (want - n) * sizeof(n16));
+		if (n) pcm_underruns++;   /* logged from the main thread, never under the audio lock */
+	}
+}
+
+#ifndef GNUBOY_DISABLE_SDL_SOUND
+#ifndef OHBOY_DISABLE_SDL_SOUND
+void pcm_init(){
+	SDL_AudioSpec as;
+	char drv[32] = "?";
+
+	pcm_ok = 0;
+	if (getenv("OHBOY_BENCH") && *getenv("OHBOY_BENCH") == '1') {
+		/* s583: speed test. No sound card and no waiting: the emulator runs flat out, still mixing
+		** and converting the sound, so every run does the same work. Never set on the device. */
+		pcm_bench = 1;
+		pcm.hz = PCM_SAMPLERATE; pcm.stereo = 1; pcm.len = PCM_FRAME<<1; pcm.buf = pcm_frame; pcm.pos = 0;
+		pcm_bufferlen = PCM_BUFFER << 1; pcm_rd = pcm_wr = 0; pcm_buffered = 0; pcm_ok = 1;
+		fprintf(stderr, "ohboy: OHBOY_BENCH=1, no audio device, no pacing\n");
+		return;
+	}
+	if (SDL_InitSubSystem(SDL_INIT_AUDIO) < 0) {
+		fprintf(stderr, "ohboy: SDL audio init FAILED: %s (no sound)\n", SDL_GetError());
+		return;
+	}
+
+	as.freq = PCM_SAMPLERATE;
+	as.format = AUDIO_S16;
+	as.channels = 2;
+	as.samples = PCM_FRAME;
+	as.callback = audio_callback;
+	as.userdata = 0;
+
+	if (SDL_OpenAudio(&as, 0)) {
+		fprintf(stderr, "ohboy: SDL_OpenAudio FAILED: %s (no sound)\n", SDL_GetError());
+		return;
+	}
+	SDL_AudioDriverName(drv, sizeof drv);
+	fprintf(stderr, "ohboy: audio %s, %d Hz, %d ch, %d samples per callback\n", drv, as.freq, as.channels, as.samples);
+
+	pcm.hz = as.freq;
+	pcm.stereo = as.channels - 1;
+	pcm.len = PCM_FRAME<<pcm.stereo;
+	pcm.buf = pcm_frame;
+	pcm.pos = 0;
+	memset(pcm.buf, 0, pcm.len * sizeof *pcm.buf);
+
+	pcm_bufferlen = PCM_BUFFER << pcm.stereo;
+	pcm_rd = pcm_wr = 0;
+	pcm_buffered = 0;
+	pcm_ok = 1;
+
+	SDL_PauseAudio(0);
+}
+
+int pcm_submit(){
+	static int lastbuffer = 0;
+	n16 *src;
+	int sample;
+	n16 *dst;
+	int i, buffered;
+	Uint32 t0 = 0;
+#define DEBUG_DISABLE_SOUND
+#undef DEBUG_DISABLE_SOUND
+#ifdef DEBUG_DISABLE_SOUND
+return 0; /* no sound */
+#endif /* DEBUG_DISABLE_SOUND */
+
+	if (!pcm_ok) {
+		pcm.pos = 0;   /* keep sound_mix() inside pcm.buf */
+		return 0;      /* no working audio: let emu_run() pace by timer */
+	}
+	if(pcm.pos<pcm.len)
+		return 1;
+
+	/* wait for room for one block, yielding the CPU to the audio thread */
+	if (pcm_bench) pcm_buffered = 0;   /* speed test: a sound card that is always ready */
+	for (;;) {
+		SDL_LockAudio();
+		buffered = pcm_buffered;
+		SDL_UnlockAudio();
+		if (buffered + pcm.len <= pcm_bufferlen) {
+			if (t0) { struct timeval tv; gettimeofday(&tv, 0); pcm_wait_us += tv.tv_sec * 1000000LL + tv.tv_usec; }
+			break;
+		}
+		if (!t0) { struct timeval tv; gettimeofday(&tv, 0); pcm_wait_us -= tv.tv_sec * 1000000LL + tv.tv_usec; t0 = SDL_GetTicks(); }
+		if (ohb_quit_requested) {
+			pcm.pos = 0;   /* quitting: drop this block */
+			return 1;
+		}
+		if (SDL_GetTicks() - t0 >= 500) {
+			fprintf(stderr, "ohboy: audio stalled for 500 ms, sound off, timer pacing\n");
+			SDL_PauseAudio(1);
+			pcm_ok = 0;
+			pcm.pos = 0;
+			return 0;
+		}
+		SDL_Delay(1);
+	}
+
+	pcm_soft_volume += dvolume;
+	if(pcm_soft_volume < 0)
+		pcm_soft_volume = 0;
+	else if(pcm_soft_volume >256)
+		pcm_soft_volume = 256;
+
+	/* convert into the ring; only the producer moves pcm_wr, and the free space checked
+	   above can only grow while we write, so the copy itself needs no lock */
+	/* s583: 12-bit mix sample (-2048..2047) * volume (0..256) / 16 fits 16 bits for
+	** VOL_MULTIPLIER 1; the old 8-bit path gave the same level with 16x coarser steps.
+	** Written in at most two runs (up to the ring's end, then from its start) instead of
+	** testing for the wrap after every sample. */
+	src = pcm.buf;
+	{
+		int vol = pcm_soft_volume * VOL_MULTIPLIER, run, left = pcm.pos, at = pcm_wr;
+		while (left > 0) {
+			run = pcm_bufferlen - at;
+			if (run > left) run = left;
+			dst = pcm_buffer + at;
+			for (i = 0; i < run; i++) {
+				sample = (*src++) * vol >> 4;
+				if (sample > 32767) sample = 32767;
+				else if (sample < -32768) sample = -32768;
+				*dst++ = sample;
+			}
+			left -= run;
+			at = 0;
+		}
+	}
+	SDL_LockAudio();
+	if (pcm_bench) for (i = 0; i < pcm.pos; i++)   /* hash of the old 8-bit value: must not change */
+		bench_sound_hash = (bench_sound_hash ^ (byte)((pcm.buf[i] >> 4) + 128)) * 16777619u;
+	pcm_wr = (pcm_wr + pcm.pos) % pcm_bufferlen;
+	pcm_buffered += pcm.pos;
+	buffered = pcm_buffered;
+	SDL_UnlockAudio();
+	pcm.pos = 0;
+	{
+		static int logged = 0;
+		int u = pcm_underruns;
+		if (u > logged && logged < 5) { fprintf(stderr, "ohboy: audio underruns so far: %d\n", u); logged = u; }
+	}
+
+	if(frameskip==-1){
+		/* s580: auto frameskip. Old rule (queue shrank -> stop drawing; only an exactly full
+		** or empty queue -> draw again) could stop drawing for good. Now: if only the block
+		** just added is queued we are behind, so skip drawing the next frame, but never more
+		** than 3 frames in a row. */
+		static int skipped = 0;
+		if (buffered <= pcm.len && skipped < 3) { vid_fb.enabled = 0; skipped++; }
+		else { vid_fb.enabled = 1; skipped = 0; }
+	}
+	lastbuffer = buffered;
+
+	return 1;
+}
+
+void pcm_close() {
+	SDL_CloseAudio();
+}
+#endif /* OHBOY_DISABLE_SDL_SOUND */
+#endif /* GNUBOY_DISABLE_SDL_SOUND */
+

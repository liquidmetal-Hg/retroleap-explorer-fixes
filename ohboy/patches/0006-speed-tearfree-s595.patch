-	n16 *src;
-	int sample;
-	n16 *dst;
-	int i, buffered;
-	Uint32 t0 = 0;
-#define DEBUG_DISABLE_SOUND
-#undef DEBUG_DISABLE_SOUND
-#ifdef DEBUG_DISABLE_SOUND
-return 0; /* no sound */
-#endif /* DEBUG_DISABLE_SOUND */
-
-	if (!pcm_ok) {
-		pcm.pos = 0;   /* keep sound_mix() inside pcm.buf */
-		return 0;      /* no working audio: let emu_run() pace by timer */
-	}
-	if(pcm.pos<pcm.len)
-		return 1;
-
-	/* wait for room for one block, yielding the CPU to the audio thread */
-	if (pcm_bench) pcm_buffered = 0;   /* speed test: a sound card that is always ready */
-	for (;;) {
-		SDL_LockAudio();
-		buffered = pcm_buffered;
-		SDL_UnlockAudio();
-		if (buffered + pcm.len <= pcm_bufferlen) {
-			if (t0) { struct timeval tv; gettimeofday(&tv, 0); pcm_wait_us += tv.tv_sec * 1000000LL + tv.tv_usec; }
-			break;
-		}
-		if (!t0) { struct timeval tv; gettimeofday(&tv, 0); pcm_wait_us -= tv.tv_sec * 1000000LL + tv.tv_usec; t0 = SDL_GetTicks(); }

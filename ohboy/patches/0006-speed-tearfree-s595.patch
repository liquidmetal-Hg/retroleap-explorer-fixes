+void store_lastframe(){
+	un16 *src = (un16 *) fb.ptr;
+	un16 *dst = (un16*) lastframe_fb.ptr;
+	int x=0, y=0;
+
+	for(y=0; y<144; y++){
+		memcpy(dst, src, 2*160);
+		src += 160;
+		dst += 160;
+	}
+}

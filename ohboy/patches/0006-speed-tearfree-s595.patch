-	pcm_wr = (pcm_wr + pcm.pos) % pcm_bufferlen;
-	pcm_buffered += pcm.pos;
-	buffered = pcm_buffered;
-	SDL_UnlockAudio();
-	pcm.pos = 0;
-	{
-		static int logged = 0;
-		int u = pcm_underruns;
-		if (u > logged && logged < 5) { fprintf(stderr, "ohboy: audio underruns so far: %d\n", u); logged = u; }
-	}

-			pcm.pos = 0;   /* quitting: drop this block */
-			return 1;
-		}
-		if (SDL_GetTicks() - t0 >= 500) {
-			fprintf(stderr, "ohboy: audio stalled for 500 ms, sound off, timer pacing\n");
-			SDL_PauseAudio(1);
-			pcm_ok = 0;
-			pcm.pos = 0;
-			return 0;
-		}
-		SDL_Delay(1);
-	}
-
-	pcm_soft_volume += dvolume;
-	if(pcm_soft_volume < 0)
-		pcm_soft_volume = 0;
-	else if(pcm_soft_volume >256)
-		pcm_soft_volume = 256;

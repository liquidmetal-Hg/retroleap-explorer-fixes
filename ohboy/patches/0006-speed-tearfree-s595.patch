-	if(frameskip==-1){
-		/* s580: auto frameskip. Old rule (queue shrank -> stop drawing; only an exactly full
-		** or empty queue -> draw again) could stop drawing for good. Now: if only the block
-		** just added is queued we are behind, so skip drawing the next frame, but never more
-		** than 3 frames in a row. */
-		static int skipped = 0;
-		if (buffered <= pcm.len && skipped < 3) { vid_fb.enabled = 0; skipped++; }
-		else { vid_fb.enabled = 1; skipped = 0; }
-	}
-	lastbuffer = buffered;
-
-	return 1;
-}

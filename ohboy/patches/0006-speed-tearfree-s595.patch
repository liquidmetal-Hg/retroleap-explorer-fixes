-void ohb_loadrom(char *rom){
-	char *base, *save, *ext=0, *tok;
-	sys_sanitize(rom);
-
-	save = strdup(rom);
-	base = strtok(save, DIRSEP);
-	while(tok = strtok(NULL, DIRSEP))
-		base = tok;
-	tok = base;
-	while(*tok){
-		if(*tok == '.') ext = tok;
-		tok++;
-	}
-	if(ext)
-		*ext = 0;
-
-	rc_setvar("savename", rcv_string, &base);
-	free(save);
-
-	loader_init(rom);
-	emu_reset();
-	autostate_load();   /* s577: resume where the power button left off */
-	vid_init();
-	scaler_init(0);
-}

-/*
-** s583 (patch 0010): direct screen writes. On the Leapster the screen surface is SDL_SWSURFACE, a
-** RAM copy that SDL_Flip copies to the framebuffer: measured 2.1 ms per frame, on top of 1.1 ms
-** for the scaler (device-upscale-2026-11-22.txt). When a frame is only the plain fullscreen scale
-** (upscaler 4, no blending, no volume bar, no FPS counter, no clear) it is scaled straight into
-** the visible framebuffer and SDL_Flip is skipped. SDL's RAM copy is then stale; vid_shadow_sync()
-** (called by gui_begin before the menu copies the screen as its background) refreshes it.
-** Every other frame takes the old path, which redraws the whole RAM copy and flips it.
-** Used only with SDL's fbcon driver on /dev/fb0 in exactly the screen's format (320x240, 16 bpp
-** RGB565 packed, 640-byte lines, no x offset), and only while the framebuffer is not panned
-** (checked before every direct frame). OHBOY_NODIRECT=1 turns it off. Known, accepted: after a
-** console switch SDL may flash its stale copy for one frame (Codex chunk 9; never seen here).
-*/
-static un16 *vid_direct = 0;
-static int vid_direct_state = 0;   /* 0 = not tried yet, 1 = usable, -1 = off */
-static int vid_shadow_stale = 0;
-static int vid_direct_fd = -1;
-static unsigned vid_direct_yoff;
-
-static int vid_direct_ok()
-{
-	struct fb_var_screeninfo v;
-	struct fb_fix_screeninfo f;
-	int fd;
-	void *m;
-	char drv[16];
-	const char *dev = getenv("SDL_FBDEV");
-	if (vid_direct_state > 0)
-	{
-		/* still the same screen position? (SDL or another program could pan the framebuffer) */
-		if (ioctl(vid_direct_fd, FBIOGET_VSCREENINFO, &v) == 0 && v.yoffset == vid_direct_yoff && v.xoffset == 0)
-			return 1;
-		vid_direct_state = -1;
-		fprintf(stderr, "ohboy: framebuffer moved, direct video writes off\n");
-		return 0;
-	}
-	if (vid_direct_state) return 0;
-	vid_direct_state = -1;
-	if (getenv("OHBOY_NODIRECT") && *getenv("OHBOY_NODIRECT") == '1') return 0;
-	/* only SDL's own fbcon driver on /dev/fb0, with the screen as a plain software surface */
-	if (!SDL_VideoDriverName(drv, sizeof drv) || strcmp(drv, "fbcon") || (dev && strcmp(dev, "/dev/fb0"))) return 0;
-	if (!screen || (screen->flags & (SDL_HWSURFACE | SDL_DOUBLEBUF)) || screen->w != 320 || screen->h != 240
-		|| screen->pitch != 640 || screen->format->BitsPerPixel != 16 || screen->format->Rmask != 0xf800
-		|| screen->format->Gmask != 0x07e0 || screen->format->Bmask != 0x001f) return 0;
-	if ((fd = open("/dev/fb0", O_RDWR)) < 0) return 0;
-	if (ioctl(fd, FBIOGET_VSCREENINFO, &v) || ioctl(fd, FBIOGET_FSCREENINFO, &f)
-		|| f.type != FB_TYPE_PACKED_PIXELS || v.xres != 320 || v.yres != 240 || v.xoffset != 0
-		|| v.bits_per_pixel != 16 || f.line_length != 640
-		|| v.red.offset != 11 || v.red.length != 5 || v.red.msb_right
-		|| v.green.offset != 5 || v.green.length != 6 || v.green.msb_right
-		|| v.blue.offset != 0 || v.blue.length != 5 || v.blue.msb_right
-		|| (f.smem_start & 4095) || (v.yoffset + 240) * 640 > f.smem_len) { close(fd); return 0; }
-	m = mmap(0, (v.yoffset + 240) * 640, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
-	if (m == MAP_FAILED) { close(fd); return 0; }
-	vid_direct = (un16 *)((byte *)m + v.yoffset * 640);
-	vid_direct_fd = fd;   /* kept open for the per-frame position check */
-	vid_direct_yoff = v.yoffset;
-	fprintf(stderr, "ohboy: video writes go straight to /dev/fb0 (OHBOY_NODIRECT=1 = off)\n");
-	vid_direct_state = 1;
-	return 1;
-}

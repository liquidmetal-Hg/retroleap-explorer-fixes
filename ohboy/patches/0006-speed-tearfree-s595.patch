-/*
-** s580 sound path rework (Leapster Explorer):
-**  - the ring buffer is guarded by SDL_LockAudio() (the callback runs under the same lock);
-**    before, pcm_buffered += / -= raced between the emulator and the audio thread
-**  - the callback copies what is really queued (any len) and leaves silence for the rest
-**  - the producer waits with SDL_Delay(1) instead of a 100% CPU spin (one ARM9 core is
-**    shared with the audio thread), gives up after 500 ms, and still honours SIGTERM
-**  - SDL audio errors are logged; if audio can't open, pcm_submit() returns 0 so the
-**    emulator falls back to timer pacing (before: no sound AND no speed limit, silently)
-*/
-void sram_flush_now();   /* s580, gnuboy/loader.c */
-void ev_clear();   /* s580, gnuboy/events.c */
-void pad_refresh();
-static int pcm_ok = 0;
-static int pcm_rd = 0, pcm_wr = 0;
-static volatile int pcm_underruns = 0;   /* ring indices in n16 samples, guarded by SDL audio lock */
-extern volatile sig_atomic_t ohb_quit_requested;
-
-static void audio_callback(void *d, byte *stream, int len) {
-	int want = len / (int) sizeof(n16), n, first;
-	n16 *out = (n16 *) stream;
-
-	n = pcm_buffered < want ? pcm_buffered : want;
-	first = pcm_bufferlen - pcm_rd;
-	if (first > n) first = n;
-	memcpy(out, pcm_buffer + pcm_rd, first * sizeof(n16));
-	if (n > first) memcpy(out + first, pcm_buffer, (n - first) * sizeof(n16));
-	pcm_rd = (pcm_rd + n) % pcm_bufferlen;
-	pcm_buffered -= n;
-	if (n < want) {
-		memset(out + n, 0, (want - n) * sizeof(n16));
-		if (n) pcm_underruns++;   /* logged from the main thread, never under the audio lock */
-	}
-}

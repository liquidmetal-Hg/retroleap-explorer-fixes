+static int mapscancode(SDLKey sym)
+{
+	/* this could be faster:  */
+	/*  build keymap as int keymap[256], then ``return keymap[sym]'' */
+
+	int i;
+	for (i = 0; keymap[i][0]; i++)
+		if (keymap[i][0] == sym)
+			return keymap[i][1];
+	if (sym >= '0' && sym <= '9')
+		return sym;
+	if (sym >= 'a' && sym <= 'z')
+		return sym;
+	return 0;
+}

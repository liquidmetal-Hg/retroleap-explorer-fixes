+static int bad_signals[] =
+{
+	/* These are all standard, so no need to #ifdef them... */
+	SIGINT, SIGSEGV, SIGTERM, SIGFPE, SIGABRT, SIGILL,
+#ifdef SIGQUIT
+	SIGQUIT,
+#endif
+#ifdef SIGPIPE
+	SIGPIPE,
+#endif
+	0
+};
+
+volatile sig_atomic_t ohb_quit_requested = 0;   /* s577 */
+
+static void fatalsignal(int s)
+{
+	if (s == SIGTERM || s == SIGINT) {
+		/* s577: power button / shutdown. Checked once per frame in doevents()
+		 * and in the menu loop, which then exit cleanly (auto save-state + SRAM). */
+		ohb_quit_requested = 1;
+		signal(s, fatalsignal);
+		return;
+	}
+	{
+		/* s580: a crash may mean corrupted memory. exit() would run cleanup(), which saves
+		** SRAM/RTC over the last good files. Leave without any atexit handler instead. */
+		static const char msg[] = "ohboy: fatal signal, exiting WITHOUT saving\n";
+		write(2, msg, sizeof msg - 1);
+		_exit(128 + s);
+	}
+}
+
+static void catch_signals()
+{
+	int i;
+	for (i = 0; bad_signals[i]; i++)
+		signal(bad_signals[i], fatalsignal);
+}

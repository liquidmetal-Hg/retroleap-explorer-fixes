 	name = malloc(strlen(saveprefix) + 5);
 	sprintf(name, "%s.%03d", saveprefix, n);
 
-	if ((f = fopen(name, "wb")))
+	{
+		char *tmp;
+		if ((f = atomic_open(name, &tmp)))
+		{

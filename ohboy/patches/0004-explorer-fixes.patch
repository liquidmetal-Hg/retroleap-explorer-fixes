+			atomic_close(f, tmp, name, !ferror(f));
+		}
+		else free(tmp);
+	}
+	free(name);
+}
+
+/* explorer-fixes: automatic save-state written on a clean exit (Quit / power button),
+ * loaded once on the next start of the same ROM, then renamed to .aut.prev.
+ * The name contains the ROM's header and global checksum (0x14D-0x14F), so two
+ * different ROMs with the same file name never share an auto-state. */
+static char *autostate_name(const char *suffix)
+{
+	char *name;
+	if (!saveprefix || !rom.bank) return 0;
+	name = malloc(strlen(saveprefix) + 32);
+	sprintf(name, "%s.%02x%02x%02x.aut%s", saveprefix,
+		rom.bank[0][0x14d], rom.bank[0][0x14e], rom.bank[0][0x14f], suffix);
+	return name;
+}
+
+void autostate_save()
+{
+	FILE *f;
+	char *name, *tmp;
+	if (!romfile || !(name = autostate_name(""))) return;
+	if ((f = atomic_open(name, &tmp)))
 	{
 		savestate(f);
-		fclose(f);
+		atomic_close(f, tmp, name, !ferror(f));
 	}
+	else free(tmp);
 	free(name);
 }
 
+int autostate_load()
+{
+	FILE *f;
+	char *name, *prev;
+	int done = 0;
+	if (!(name = autostate_name(""))) return 0;
+	prev = autostate_name(".prev");
+	/* consume first (durably), then parse: if loading crashes, the next start won't retry it */
+	if (rename(name, prev) == 0)
+	{
+		fsync_dir_of(prev);
+		if ((f = fopen(prev, "rb")))
+		{
+			loadstate(f);
+			fclose(f);
+			vram_dirty();
+			pal_dirty();
+			sound_dirty();
+			mem_updatemap();
+			done = 1;
+		}
+	}
+	free(name); free(prev);
+	return done;
+}
+
 

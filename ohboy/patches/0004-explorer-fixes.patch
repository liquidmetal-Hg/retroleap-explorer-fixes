+/* Explorer fixes: atomic file writes (tmp + fsync + rename) so an interrupted
+ * or failed save never destroys the previous good one. */
+#include <unistd.h>
+#include <fcntl.h>
+#include <errno.h>
+int ohb_clean_exit = 0;      /* set on Quit / SIGTERM: write the auto save-state */
+
+static FILE *atomic_open(const char *final, char **tmp)
+{
+	*tmp = malloc(strlen(final) + 5);
+	sprintf(*tmp, "%s.tmp", final);
+	return fopen(*tmp, "wb");
+}
+
+static void fsync_dir_of(const char *path)
+{
+	char *d = strdup(path), *p = strrchr(d, '/');
+	int fd;
+	if (p) { *p = 0; if ((fd = open(*d ? d : "/", O_RDONLY)) >= 0) { if (fsync(fd) != 0) fprintf(stderr, "ohboy: fsync of %s failed\n", d); close(fd); } }
+	free(d);
+}
+
+/* ok = all writes succeeded; returns 0 on success, -1 (old file kept) on failure */
+static int atomic_close(FILE *f, char *tmp, const char *final, int ok)
+{
+	int rc = -1;
+	if (fflush(f) != 0) ok = 0;
+	if (ok && fsync(fileno(f)) != 0) ok = 0;
+	if (fclose(f) != 0) ok = 0;
+	if (ok && rename(tmp, final) == 0) { fsync_dir_of(final); rc = 0; }
+	else { unlink(tmp); fprintf(stderr, "ohboy: saving %s FAILED (old file kept)\n", final); }
+	free(tmp);
+	return rc;
+}
+
